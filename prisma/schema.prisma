generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkType {
  INCIDENT
  CUSTOMER_ISSUE
  PAYMENT
  COMPLIANCE
  TASK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum ActivityType {
  CREATED
  UPDATED
  CLAIMED
  ASSIGNED
  PRIORITY_CHANGED
  STATUS_CHANGED
  COMMENTED
  NOTE_DELETED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  memberships  Membership[]
  createdItems WorkItem[]       @relation("CreatedItems")
  assignedItems WorkItem[]     @relation("AssignedItems")
  activities   ActivityEvent[]
  comments     Comment[]
  idempotency  IdempotencyKey[]
  createdAt    DateTime         @default(now())
}

model Team {
  id          String       @id @default(cuid())
  name        String       @unique
  memberships Membership[]
  items       WorkItem[]
  createdAt   DateTime     @default(now())
}

model Membership {
  userId    String
  teamId    String
  role      TeamRole
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, teamId])
  @@index([teamId, role])
}

model WorkItem {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  type        WorkType
  priority    Priority     @default(MEDIUM)
  status      WorkStatus   @default(OPEN)
  teamId      String
  assigneeId  String?
  createdById String
  dueAt       DateTime?
  version     Int          @default(1)
  team        Team         @relation(fields: [teamId], references: [id])
  assignee    User?        @relation("AssignedItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("CreatedItems", fields: [createdById], references: [id])
  activities  ActivityEvent[]
  comments    Comment[]
  idempotency IdempotencyKey?
  outbox      OutboxJob[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId, status, priority, createdAt, id])
  @@index([teamId, assigneeId, status, createdAt, id])
  @@index([createdAt, id])
}

model ActivityEvent {
  id         String       @id @default(cuid())
  itemId     String
  actorId    String
  type       ActivityType
  message    String
  metadata   Json?
  item       WorkItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor      User         @relation(fields: [actorId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([itemId, createdAt, id])
}

model Comment {
  id        String   @id @default(cuid())
  itemId    String
  authorId  String
  body      String   @db.Text
  item      WorkItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([itemId, createdAt, id])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  key       String
  itemId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      WorkItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, key])
}

model OutboxJob {
  id          String      @id @default(cuid())
  itemId      String
  kind        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int         @default(0)
  availableAt DateTime    @default(now())
  lockedAt    DateTime?
  processedAt DateTime?
  lastError   String?
  item        WorkItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([status, availableAt, createdAt])
}
